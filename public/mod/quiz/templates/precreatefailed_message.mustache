{{!
    @template mod_quiz/precreatefailed_message

    The body for the pre-create failed message.

    Example context (json):
    {
        "fullname" : "John Doe",
        "count" : 1,
        "items" : [
            {
                "url": "https://example.com/mod/quiz/view.php?id=1",
                "quizname": "Quiz 1",
                "message": "Example exception message"
            }
        ]
    }
}}
<p>{{ fullname }},</p>
{{#str}} precreatefailed:body:start, quiz, { "count": {{count}} }{{/str}}
<ul>
  {{#items}}
    <li>
      <a href="{{ url }}">{{ quizname }}</a>: {{#str}} precreatefailed:body:reason, quiz, {{ message }} {{/str}}
    </li>
  {{/items}}
</ul>
{{#str}} precreatefailed:body:finish, quiz {{/str}}
