{{!
    @template qbank_history/available_history

    The available history description and reasons for the history page.
    * description - The description why not all versions may be shown.
    * reasons - An array of each reason

    Example context (json):
    {
        "description": "This page shows all available versions of this question. It may not show all versions due to the following:",
        "reasons": [
            "Versions older than 1 days that are unused are deleted automatically (excluding the earliest and latest versions).",
            "Versions can be manually deleted by users."
        ]
    }
}}

{{#availablehistory}}
<div class="row">
    <div>
        <p>{{description}}</p>
        <ul>
            {{#reasons}}
                <li>{{.}}</li>
            {{/reasons}}
        </ul>
    </div>
</div>
{{/availablehistory}}
